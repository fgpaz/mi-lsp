{
  "schema": "victory-fixture-metadata/v2",
  "fixture_id": "graph-native-go-callers-affected-path",
  "repository_identity": "https://example.com/mi-lsp/victory-lab-v2",
  "backend": "go",
  "language": "go",
  "project_or_module": "go/go.mod",
