{
  "schema": 1,
  "repos": {
    "mi-lsp": {
      "root": "mi-lsp",
      "language": "go",
      "globs": ["*.go"],
      "def_regex": "^func (\\(.*\\) )?{sym}\\(|^type {sym}\\b"
    },
    "mi-gateway": {
      "root": "mi-gateway",
      "language": "go",
      "globs": ["*.go"],
      "def_regex": "^func (\\(.*\\) )?{sym}\\(|^type {sym}\\b"
    },
    "pi-subagents": {
      "root": "pi-subagents",
      "language": "typescript",
      "globs": ["*.ts", "*.tsx"],
      "def_regex": "^\\s*(export )?(default )?(declare )?(abstract )?(async )?(function\\*?|class|interface|type|const|let|enum) {sym}\\b"
    },
    "tedi-memory": {
      "root": "tedi-memory",
      "language": "csharp",
      "globs": ["*.cs"],
      "def_regex": "\\b(class|interface|record|struct|enum)\\s+{sym}\\b"
    }
  },
