# Pegá esto en ~/.codex/config.toml (o en .codex/config.toml del proyecto).
# Identifica la telemetría local de mi-lsp como proveniente de Codex.
# En Windows, si `mi-lsp` resuelve a un .cmd, usá la ruta del .exe real.
# MI_LSP_BIN no sustituye `command`: Codex lanza este proceso tal cual.

[mcp_servers.mi-lsp]
command = "mi-lsp"
args = ["mcp"]
shell_environment_policy = { set = { MI_LSP_CLIENT_NAME = "codex" } }
