{
  "format": "mi-mcp-provider/v2",
  "namespace": "milsp",
  "provider_version": "0.10.1",
  "min_provider_version": "0.10.0",
  "contracts": {
    "--help": "mi-lsp-help/v0",
    "--version": "mi-lsp-version-flag/v0",
    "q": "q-v1",
    "schema": "mi-lsp-schema/v0",
    "version": "mi-lsp-version/v0"
  },
  "auth": "none",
  "invocation": {
    "kind": "cli",
    "command": "mi-lsp",
    "fixed_args": [
      "--format",
      "json",
      "--client-name",
      "mi-mcp",
      "--no-auto-register"
    ],
    "socket": {
      "transport": "unix",
      "path_env": "XDG_RUNTIME_DIR",
      "filename": "mi-lsp.sock",
      "mode": "0600",
      "framing": "jsonl",
      "max_request_bytes": 1048576,
      "fallback": "connection_failure_only",
      "retry_after_response": false
    }
  },
  "operations": [
    {
      "name": "q",
      "effect": "read",
      "contract": "q-v1",
      "input_schema": {
        "type": "object",
        "required": [
          "pipeline"
        ],
        "additionalProperties": false,
        "properties": {
          "pipeline": {
            "type": "string",
            "minLength": 1
          },
          "workspace": {
            "type": "string"
          },
          "budget": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12000
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1024
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000
          },
          "session_id": {
            "type": "string"
          },
          "page": {
            "type": "string"
          },
          "fresh": {
            "type": "boolean"
          },
          "dedupe": {
            "type": "boolean"
          }
        }
      },
      "output": {
        "contract_version": "q-v1",
        "ref": "mi-lsp .docs/wiki/09_contratos/CT-Q-V1.md"
      }
    },
    {
      "name": "version",
      "effect": "read",
      "contract": "mi-lsp-version/v0",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      }
    },
    {
      "name": "schema",
      "effect": "read",
      "contract": "mi-lsp-schema/v0",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      }
    },
    {
      "name": "--help",
      "effect": "read",
      "contract": "mi-lsp-help/v0",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      }
    },
    {
      "name": "--version",
      "effect": "read",
      "contract": "mi-lsp-version-flag/v0",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      }
    }
  ]
}
