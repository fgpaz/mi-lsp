{
  "format": "mi-mcp-provider/v2",
  "namespace": "milsp",
  "binary": "mi-lsp",
  "provider_version": "(devel)",
  "description": "Semantic code navigation and query operations",
  "tags": [
    "code",
    "navigation",
    "semantic search",
    "workspace"
  ],
  "min_provider_version": "0.10.0",
  "contracts": {
    "--help": "mi-lsp-help/v0",
    "--version": "mi-lsp-version-flag/v0",
    "intent": "mi-lsp-nav-intent/v0",
    "multi-read": "mi-lsp-nav-multi-read/v0",
    "q": "q-v1",
    "schema": "mi-lsp-schema/v0",
    "version": "mi-lsp-version/v0",
    "wiki_graph": "wiki-graph/v1",
    "wiki_validate_contract": "wiki-contract/v1"
  },
  "auth": "none",
  "invocation": {
    "kind": "cli",
    "command": "mi-lsp",
    "fixed_args": [
      "--format",
      "json",
      "--client-name",
      "mi-mcp",
      "--no-auto-register"
    ],
    "input_mapping": {
      "operation": {
        "source": "subcommand"
      },
      "operations": {
        "intent": {
          "offset": {
            "flag": "--offset",
            "source": "option"
          },
          "question": {
            "position": 0,
            "source": "argument"
          },
          "repo": {
            "flag": "--repo",
            "source": "option"
          },
          "top": {
            "flag": "--top",
            "source": "option"
          },
          "workspace": {
            "flag": "--workspace",
            "source": "option"
          }
        },
        "multi-read": {
          "ranges": {
            "multiple": true,
            "position": 0,
            "source": "argument"
          },
          "workspace": {
            "flag": "--workspace",
            "source": "option"
          }
        },
        "q": {
          "budget": {
            "flag": "--budget",
            "source": "option"
          },
          "dedupe": {
            "flag": "--dedupe",
            "source": "option"
          },
          "fresh": {
            "flag": "--fresh",
            "source": "option"
          },
          "max_bytes": {
            "flag": "--max-bytes",
            "source": "option"
          },
          "page": {
            "flag": "--page",
            "source": "option"
          },
          "pipeline": {
            "position": 0,
            "source": "argument"
          },
          "session_id": {
            "flag": "--session-id",
            "source": "option"
          },
          "timeout_ms": {
            "flag": "--timeout-ms",
            "source": "option"
          },
          "workspace": {
            "flag": "--workspace",
            "source": "option"
          }
        }
      }
    },
    "output": "json",
    "socket": {
      "transport": "unix",
      "path_env": "XDG_RUNTIME_DIR",
      "filename": "mi-lsp.sock",
      "mode": "0600",
      "framing": "jsonl",
      "max_request_bytes": 1048576,
      "fallback": "connection_failure_only",
      "retry_after_response": false
    }
  },
  "operations": [
    {
      "name": "q",
      "description": "Run a typed mi-lsp query pipeline",
      "effect": "read",
      "contract": "q-v1",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "budget": {
            "maximum": 12000,
            "minimum": 1,
            "type": "integer"
          },
          "dedupe": {
            "type": "boolean"
          },
          "fresh": {
            "type": "boolean"
          },
          "max_bytes": {
            "minimum": 1024,
            "type": "integer"
          },
          "page": {
            "minLength": 0,
            "type": "string"
          },
          "pipeline": {
            "minLength": 1,
            "type": "string"
          },
          "session_id": {
            "minLength": 0,
            "type": "string"
          },
          "timeout_ms": {
            "maximum": 30000,
            "minimum": 1,
            "type": "integer"
          },
          "workspace": {
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "pipeline"
        ],
        "type": "object"
      },
      "output_schema": {
        "description": "Response governed by q-v1",
        "type": "object"
      }
    },
    {
      "name": "intent",
      "description": "Resolve a navigation intent",
      "effect": "read",
      "contract": "mi-lsp-nav-intent/v0",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "offset": {
            "minimum": 0,
            "type": "integer"
          },
          "question": {
            "minLength": 1,
            "type": "string"
          },
          "repo": {
            "minLength": 0,
            "type": "string"
          },
          "top": {
            "minimum": 1,
            "type": "integer"
          },
          "workspace": {
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "type": "object"
      },
      "output_schema": {
        "description": "Response governed by mi-lsp-nav-intent/v0",
        "type": "object"
      }
    },
    {
      "name": "multi-read",
      "description": "Read the requested source ranges",
      "effect": "read",
      "contract": "mi-lsp-nav-multi-read/v0",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "ranges": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "workspace": {
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "ranges"
        ],
        "type": "object"
      },
      "output_schema": {
        "description": "Response governed by mi-lsp-nav-multi-read/v0",
        "type": "object"
      }
    },
    {
      "name": "wiki_graph",
      "description": "Query the unified wiki and code graph",
      "effect": "read",
      "contract": "wiki-graph/v1",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "changed_paths": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "cursor": {
            "minLength": 0,
            "type": "string"
          },
          "depth": {
            "minimum": 0,
            "type": "integer"
          },
          "direction": {
            "enum": [
              "in",
              "out",
              "both"
            ],
            "type": "string"
          },
          "from": {
            "minLength": 0,
            "type": "string"
          },
          "limit": {
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "mode": {
            "enum": [
              "neighbors",
              "path",
              "explain",
              "affected",
              "change-pack",
              "matrix"
            ],
            "type": "string"
          },
          "ref": {
            "minLength": 0,
            "type": "string"
          },
          "relations": {
            "minLength": 0,
            "type": "string"
          },
          "render": {
            "enum": [
              "mermaid"
            ],
            "type": "string"
          },
          "to": {
            "minLength": 0,
            "type": "string"
          },
          "workspace": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "workspace",
          "mode"
        ],
        "type": "object"
      },
      "output_schema": {
        "description": "Response governed by wiki-graph/v1",
        "type": "object"
      },
      "invocation": {
        "kind": "cli",
        "command": "mi-lsp",
        "fixed_args": [
          "--format",
          "json",
          "--client-name",
          "mi-mcp",
          "--no-auto-register",
          "--no-daemon",
          "--allow-cross-workspace",
          "nav",
          "wiki",
          "graph"
        ],
        "input_mapping": {
          "fields": {
            "changed_paths": {
              "position": 0,
              "repeat": true,
              "source": "argument"
            },
            "cursor": {
              "flag": "--cursor",
              "source": "option"
            },
            "depth": {
              "flag": "--depth",
              "source": "option"
            },
            "direction": {
              "flag": "--direction",
              "source": "option"
            },
            "from": {
              "flag": "--from",
              "source": "option"
            },
            "limit": {
              "flag": "--limit",
              "source": "option"
            },
            "mode": {
              "flag": "--mode",
              "source": "option"
            },
            "ref": {
              "flag": "--ref",
              "source": "option"
            },
            "relations": {
              "flag": "--relations",
              "source": "option"
            },
            "render": {
              "flag": "--render",
              "source": "option"
            },
            "to": {
              "flag": "--to",
              "source": "option"
            },
            "workspace": {
              "flag": "--workspace",
              "source": "option"
            }
          }
        },
        "output": "json"
      }
    },
    {
      "name": "wiki_validate_contract",
      "description": "Validate WIKI-CONTRACT-v1 and its language-aware checks",
      "effect": "read",
      "contract": "wiki-contract/v1",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "ids": {
            "minLength": 0,
            "type": "string"
          },
          "paths": {
            "minLength": 0,
            "type": "string"
          },
          "workspace": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "workspace"
        ],
        "type": "object"
      },
      "output_schema": {
        "description": "Response governed by wiki-contract/v1",
        "type": "object"
      },
      "invocation": {
        "kind": "cli",
        "command": "mi-lsp",
        "fixed_args": [
          "--format",
          "json",
          "--client-name",
          "mi-mcp",
          "--no-auto-register",
          "--no-daemon",
          "--allow-cross-workspace",
          "nav",
          "wiki",
          "validate-contract"
        ],
        "input_mapping": {
          "fields": {
            "ids": {
              "flag": "--ids",
              "source": "option"
            },
            "paths": {
              "flag": "--paths",
              "source": "option"
            },
            "workspace": {
              "flag": "--workspace",
              "source": "option"
            }
          }
        },
        "output": "json"
      }
    },
    {
      "name": "version",
      "description": "Read mi-lsp provider metadata",
      "effect": "read",
      "contract": "mi-lsp-version/v0",
      "input_schema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "output_schema": {
        "description": "Response governed by mi-lsp-version/v0",
        "type": "object"
      }
    },
    {
      "name": "schema",
      "description": "Read mi-lsp provider metadata",
      "effect": "read",
      "contract": "mi-lsp-schema/v0",
      "input_schema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "output_schema": {
        "description": "Response governed by mi-lsp-schema/v0",
        "type": "object"
      }
    },
    {
      "name": "--help",
      "description": "Read mi-lsp provider metadata",
      "effect": "read",
      "contract": "mi-lsp-help/v0",
      "input_schema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "output_schema": {
        "description": "Response governed by mi-lsp-help/v0",
        "type": "object"
      }
    },
    {
      "name": "--version",
      "description": "Read mi-lsp provider metadata",
      "effect": "read",
      "contract": "mi-lsp-version-flag/v0",
      "input_schema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      },
      "output_schema": {
        "description": "Response governed by mi-lsp-version-flag/v0",
        "type": "object"
      }
    }
  ]
}
